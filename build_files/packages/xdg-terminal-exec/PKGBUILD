pkgname=xdg-terminal-exec
pkgver=0.14.3
pkgrel=1
pkgdesc="Proposal for XDG Default Terminal Execution Specification and shell-based reference implementation."
arch=(any)
url="https://github.com/Vladimir-csp/$pkgname"
license=('GPL-3.0-or-later')
makedepends=('scdoc')
changelog=
source=("$pkgname-$pkgver::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('82ac2dfdb357361d15f5163cdeb3cfd457bbb30bf5d2e14436393f493bd32afe')

build() {
	cd "$pkgname-$pkgver"
	make
}

package() {
	cd "$pkgname-$pkgver"
	make prefix="$pkgdir/usr" install
}
